# Shared formatting rules, read by IntelliJ, VS Code and ktlint
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 4
max_line_length = 140
ktlint_code_style = ktlint_official
# Function names with backticks are allowed in tests, e.g. fun `app starts`()
ktlint_function_naming_ignore_when_annotated_with = Test

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
